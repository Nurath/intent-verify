{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-intent.sh\"",
            "commandWindows": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\capture-intent.ps1\"",
            "timeout": 5,
            "statusMessage": "intent-verify: capturing intent"
          }
        ]
      }
    ]
  }
}
